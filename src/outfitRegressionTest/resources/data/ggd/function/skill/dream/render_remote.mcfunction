# Task tools own slot two. Remove only our control when a task starts; never displace its items.
execute if entity @s[tag=inTask] if items entity @s hotbar.1 *[custom_data~{DreamRemote:1b}] run item replace entity @s hotbar.1 with air
execute if entity @s[tag=inTask] run return 0
# Some tasks issue tools before their active tag is applied. Protect task items at that boundary too.
execute if items entity @s hotbar.1 *[custom_data~{task:1b}] run return 0
execute if items entity @s hotbar.1 *[custom_data~{ggdTaskCargo:1b}] run return 0
execute if items entity @s hotbar.1 * unless items entity @s hotbar.1 *[custom_data~{DreamRemote:1b}] unless items entity @s hotbar.1 *[custom_data~{ggdManagedHotbar:1b}] run return 0
execute if entity @s[tag=inDream,tag=!spectator,tag=!endGame,tag=!dreamRemote,tag=!inTask] unless items entity @s hotbar.1 carrot_on_a_stick[custom_data~{ggdHotbarState:"dream_remote_off"}] run item replace entity @s hotbar.1 with carrot_on_a_stick[item_name={"color":"#BCA6E8","italic":false,"translate":"item.dream.remote","fallback":"Remote Control"},lore=[{"color":"#DDD1F5","italic":false,"translate":"item.dream.remote.off","fallback":"Inactive: right-click to mirror turning, pose, and swings"}],custom_model_data={strings:["remote_body_control"]},custom_data={DreamRemote:1b,ggdManagedHotbar:1b,ggdHotbarSlot:1,ggdHotbarState:"dream_remote_off"}] 1
execute if entity @s[tag=inDream,tag=!spectator,tag=!endGame,tag=dreamRemote,tag=!inTask] unless items entity @s hotbar.1 carrot_on_a_stick[custom_data~{ggdHotbarState:"dream_remote_on"}] run item replace entity @s hotbar.1 with carrot_on_a_stick[item_name={"color":"#DCCBFF","italic":false,"translate":"item.dream.remote","fallback":"Remote Control"},lore=[{"color":"#A9FFB4","italic":false,"translate":"item.dream.remote.on","fallback":"Active: your proxy is mirroring your movements"}],custom_model_data={strings:["remote_body_control"]},enchantment_glint_override=true,custom_data={DreamRemote:1b,ggdManagedHotbar:1b,ggdHotbarSlot:1,ggdHotbarState:"dream_remote_on"}] 1
