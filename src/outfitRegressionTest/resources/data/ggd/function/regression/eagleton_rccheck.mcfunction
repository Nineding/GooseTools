#讨论区
#强制轮麦：当前发言者右键结束发言（实际切换由服务器上下文的 talkkl 执行）
execute if score FullBloodDLC ggdadv matches 1 if score ForceRoundMic ggdadv matches 1 as @s[tag=ggdForcedSpeaker,tag=inTalk,scores={carrotrightclick=1..},nbt={"SelectedItem":{id:"minecraft:carrot_on_a_stick",components:{"minecraft:custom_data":{end_talk:1b}}}}] at @s run function ggd:talker/forced_round/manual_request
#跳过讨论物品
execute as @s[tag=inTalk,scores={carrotrightclick=1..},nbt={"SelectedItem":{id:"minecraft:carrot_on_a_stick",components:{"minecraft:custom_data":{skiptalk:1b}}}}] at @s run function ggd:talker/skiptrigger
# 旁观专注模式（满血 DLC；trueinvis 需 goosethings 放行 FocusMode 物品）
execute if score FullBloodDLC ggdadv matches 1 if entity @s[tag=spectator,scores={carrotrightclick=1..}] if items entity @s weapon.mainhand carrot_on_a_stick[custom_data~{FocusMode:1b}] run function ggd:talker/focus_mode/toggle
# Meeting spectator dead-channel listening switch.
execute if score FullBloodDLC ggdadv matches 1 if entity @s[tag=spectator,scores={carrotrightclick=1..}] if items entity @s weapon.mainhand carrot_on_a_stick[custom_data~{DeadChannelOnly:1b}] run function ggd:talker/dead_channel/toggle
# 满血 DLC 刺客：会议第五格右键打开数据包箱子菜单。
execute if score FullBloodDLC ggdadv matches 1 if entity @s[tag=Assassin,tag=assassinMenuAvailable,tag=inTalk,tag=!spectator,scores={carrotrightclick=1..}] if items entity @s weapon.mainhand carrot_on_a_stick[custom_data~{AssassinMenu:1b}] if entity @s[nbt={SelectedItemSlot:4}] at @s run playsound minecraft:ggd/meeting/assassin_open record @s ~ ~ ~ 1 1 1
