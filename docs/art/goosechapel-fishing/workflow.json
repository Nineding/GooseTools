          0
        ],
        "upscale_method": "nearest-exact",
        "width": 832,
        "height": 640,
        "crop": "disabled"
      }
    },
    "3": {
      "class_type": "PerfectPixel",
      "inputs": {
        "image": [
          "2",
          0
        ],
        "sampling": "Majority Cluster",
        "export_scale": 1,
        "backend": "OpenCV Backend"
      }
    },
    "4": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "3",
          0
        ],
        "filename_prefix": "goosechapel_fishing/panel-grid"
      }
    },
    "5": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "3",
          0
        ],
        "upscale_method": "nearest-exact",
        "width": 208,
        "height": 160,
        "crop": "disabled"
      }
    },
    "6": {
      "class_type": "JoinImageWithAlpha",
      "inputs": {
        "image": [
          "5",
          0
        ],
        "alpha": [
          "1",
          1
        ]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "6",
          0
        ],
        "filename_prefix": "goosechapel_fishing/panel"
      }
    }
  },
